# Backend provider settings. Replace both placeholders with valid keys.
LLM_API_KEYS=your_key_1,your_key_2
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=

# Docker stores SQLite inside the named volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=false
CACHE_ENABLED=true
LITELLM_CACHE_TYPE=local

# Frontend image uses same-origin Nginx proxying by default.
VITE_API_BASE_URL=/api
